{
  "name": "install-texlive",
  "description": "Install TeX Live Action",
  "version": "0.0.0",
  "type": "module",
  "author": "Marcel Krüger",
  "private": true,
  "homepage": "https://github.com/zauguin/install-texlive",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zauguin/install-texlive.git"
  },
  "bugs": {
    "url": "https://github.com/zauguin/install-texlive/issues"
  },
  "keywords": [
    "actions",
    "texlive"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "pnpm run format:write && pnpm run package",
    "ci-test": "vitest --run",
    "check": "tsc --noEmit -p tsconfig.json",
    "coverage": "make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "prettier --write **/*.ts",
    "format:check": "prettier --check **/*.ts",
    "lint": "npx eslint . -c eslint.config.mjs",
    "package": "ncc build src/index.ts --license licenses.txt && linefix dist",
    "package:watch": "pnpm run package -- --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "all": "pnpm run format:write && pnpm run lint && pnpm run check && pnpm run test && pnpm run coverage && pnpm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "^6.3.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "decompress": "^4.2.1",
    "temporal-polyfill": "^1.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/decompress": "^4.2.7",
    "@types/node": "^25.9.9",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "linefix": "^0.1.1",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
